@model IEnumerable<BaiTapThucHanh.Models.CartItem>

@{
    ViewData["Title"] = "Giỏ Hàng Của Bạn";
    decimal totalCartPrice = Model?.Sum(item => item.TotalPrice) ?? 0;
}

<div class="container py-3">
    <!-- Tiêu đề trang -->
    <div class="d-flex align-items-center mb-4 border-bottom pb-2">
        <i class="bi bi-cart-check-fill text-success fs-1 me-3"></i>
        <div>
            <h2 class="fw-bold mb-0 text-dark">CHI TIẾT GIỎ HÀNG</h2>
            <small class="text-muted">Quản lý các sản phẩm bạn đã chọn mua</small>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5 bg-white rounded shadow-sm border">
            <i class="bi bi-cart-x text-muted" style="font-size: 5rem;"></i>
            <h4 class="mt-3 text-secondary">Giỏ hàng của bạn đang trống!</h4>
            <a asp-controller="Product" asp-action="Index" class="btn btn-success mt-3 px-4 rounded-pill">
                <i class="bi bi-arrow-left me-2"></i>Quay lại mua sắm ngay
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Bảng danh sách sản phẩm bên trái -->
            <div class="col-lg-8">
                <div class="table-responsive bg-white rounded shadow-sm">
                    <table class="table table-hover align-middle mb-0">
                        <thead style="background-color: #007b2e; color: #fedf00;">
                            <tr>
                                <th scope="col" class="py-3 ps-3">Sản phẩm</th>
                                <th scope="col" class="py-3">Giá tiền</th>
                                <th scope="col" class="py-3 text-center" style="width: 130px;">Số lượng</th>
                                <th scope="col" class="py-3">Tổng cộng</th>
                                <th scope="col" class="py-3 text-center">Xóa</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-3 py-3">
                                        <div class="d-flex align-items-center">
                                            <div class="bg-light rounded p-2 me-3 border" style="width: 60px; height: 60px; display: flex; justify-content: center; align-items: center;">
                                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                                {
                                                    <img src="/images/@item.ImageUrl" style="max-width: 100%; max-height: 100%; object-fit: contain;" alt="@item.Name" />
                                                }
                                                else
                                                {
                                                    <i class="bi bi-image text-muted fs-4"></i>
                                                }
                                            </div>
                                            <div>
                                                <h6 class="fw-bold mb-0 text-dark">@item.Name</h6>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="fw-semibold">@item.Price.ToString("#,##0") đ</td>
                                    <td>
                                        <div class="input-group input-group-sm justify-content-center">
                                            <input type="text" class="form-control text-center fw-bold bg-white" style="max-width: 60px;" value="@item.Quantity" readonly />
                                        </div>
                                    </td>
                                    <td class="fw-bold text-success">@item.TotalPrice.ToString("#,##0") đ</td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-danger border-0 rounded-circle" title="Xóa sản phẩm">
                                            <i class="bi bi-trash3-fill"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Nút quay lại mua hàng -->
                <div class="mt-3">
                    <a asp-controller="Product" asp-action="Index" class="btn btn-outline-success fw-semibold">
                        <i class="bi bi-arrow-left me-2"></i>Tiếp tục mua sắm
                    </a>
                </div>
            </div>

            <!-- Khối tính hóa đơn bên phải -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded">
                    <div class="card-header text-white fw-bold py-3" style="background-color: #007b2e;">
                        <i class="bi bi-receipt me-2"></i>TÓM TẮT ĐƠN HÀNG
                    </div>
                    <div class="card-body p-4 bg-white">
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Tạm tính:</span>
                            <span class="fw-semibold text-dark">@totalCartPrice.ToString("#,##0") đ</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Phí vận chuyển:</span>
                            <span class="fw-semibold text-success">Miễn phí</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <span class="fs-5 fw-bold text-dark">Tổng tiền:</span>
                            <span class="fs-4 fw-bold text-danger">@totalCartPrice.ToString("#,##0") đ</span>
                        </div>

                        <!-- Nút Tiến hành thanh toán có tone màu Vàng bắt mắt -->
                        <button class="btn w-100 py-2.5 fw-bold text-dark mb-2" style="background-color: #fedf00; border: 1px solid #e0c500; transition: background 0.2s;">
                            <i class="bi bi-credit-card-2-front-fill me-2"></i>TIẾN HÀNH THANH TOÁN
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    /* Hiệu ứng di chuột nhẹ cho nút thanh toán */
    button[style*="background-color: #fedf00"]:hover {
        background-color: #e5c700 !important;
    }
</style>